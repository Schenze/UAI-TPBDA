---------------------------------------------------------------------------
-- Immersive Blind Trait - client driver (Build 42)
--
-- Drives the per-player "blind vision": it reuses the engine's foraging
-- search-mode post-process (blur / desaturate / darken) plus the new-fog base
-- alpha, and flips the night-vision-goggles shader flag so the overridden
-- screen.frag renders the world in greyscale (or colour, in Moonside mode).
-- Shouting (or sneak-shouting) fires an echolocation pulse that briefly
-- sharpens the view and lifts the foraging vision penalty.
--
-- Everything here is per-local-player and fully client-side, so it is safe in
-- single-player, on multiplayer clients and in split-screen (the OnPlayerUpdate
-- event hands us the specific player being updated). The navigation glow is a
-- local light source only - it is never networked - so a blind player is not a
-- beacon to anyone else on a server.
--
-- B41 -> B42 notes:
--   * player:HasTrait("blind")  ->  MarTraitsBlind.isBlind(player)  (object trait)
--   * Moonside mode moved from ModOptions into Sandbox Options
--   * the buggy client/server glow-removal relay is gone (light is local)
--   * we only touch search-mode for blind players, so foraging still works for
--     everyone else
---------------------------------------------------------------------------

require "MarBlindShared"
require "ISUI/ISUIElement"

local function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

---------------------------------------------------------------------------
-- Navigation glow
--
-- A blind character cannot tell how dark a room is, so we keep a constant soft
-- light on them - it also lets them "see" in the dark. The light is re-seated
-- whenever they change square and torn down when they stop being blind or die.
---------------------------------------------------------------------------

local function removeGlow(player)
    local md = player:getModData()
    if md.traitBlindGlow ~= nil then
        local cell = player:getCell()
        if cell then cell:removeLamppost(md.traitBlindGlow) end
        md.traitBlindGlow = nil
    end
    md.traitBlindGlowSquare = nil
end

local function updateGlow(player)
    local md = player:getModData()

    if not MarTraitsBlind.isBlind(player) then
        if md.traitBlindGlow ~= nil then removeGlow(player) end
        return
    end

    local square = player:getSquare()
    if square == nil then return end
    -- IsoGridSquare has no stable __eq, compare by identity key (x,y,z).
    local key = square:getX() .. "," .. square:getY() .. "," .. square:getZ()
    if key == md.traitBlindGlowSquare and md.traitBlindGlow ~= nil then
        return -- still on the same square, nothing to do
    end

    local cell = player:getCell()
    if cell == nil then return end
    if md.traitBlindGlow ~= nil then cell:removeLamppost(md.traitBlindGlow) end
    md.traitBlindGlow = cell:addLamppost(player:getX(), player:getY(), player:getZ(), 255, 255, 255, 100)
    md.traitBlindGlowSquare = key
end

---------------------------------------------------------------------------
-- Echolocation pulse state (shared across the local players; one human is
-- pulsing at a time in practice)
---------------------------------------------------------------------------

local echoTime = 0      -- seconds left on the current echo pulse
local echoStrength = 0  -- 0..1, peak clarity of that pulse
local echoTimeMax = 1   -- duration the current pulse started with (for the fade)

---------------------------------------------------------------------------
-- Vision overlays
--
-- All values are in the VANILLA search-mode scale (~0..1, the same scale
-- ISSearchManager uses: foraging blur/desat ~0.5, darkness ~0.1-0.5). The B41
-- mod used 15-60, which was tuned for its own custom screen shader; fed to the
-- stock shader those values wrap into inverted neon.
--
-- KEY: the stock shader darkens with `colour *= (1 - darkness * circleAlpha)`,
-- where circleAlpha is 0 inside `radius` (clear) and 1 beyond it. So
-- darkness = 1.0 with radius = 0 renders TRULY BLACK, and an echo pulse just
-- grows the clear radius - a circle of "sight" punched through the black.
---------------------------------------------------------------------------

-- BLIND: a clear circle around you, then a TIGHT gradient straight to near-black
-- - a genuine sight cutoff, so you can't see across the map even zoomed out. A
-- yell only widens the circle (out to base+reveal tiles); it does NOT brighten
-- the dark beyond, so the cutoff always holds, even in daylight. Deaf gets no
-- echo (blocked in onEchoSound) and sits at base forever.
--   base = resting clear radius (tiles) | reveal = extra a full yell adds
--   dark = darkness past the circle (~1.0 = black) | grad = falloff width (small = hard edge)
local BLIND_DEFAULT = { base = 3.22, reveal = 5.00, dark = 0.97, blur = 1.7, desat = 1.00, grad = 2.0, fog = 0.50 }
local BLIND_KEEN    = { base = 4.48, reveal = 6.90, dark = 0.95, blur = 1.3, desat = 1.00, grad = 2.5, fog = 0.35 }
local BLIND_HARD    = { base = 2.24, reveal = 3.75, dark = 0.98, blur = 2.0, desat = 1.00, grad = 1.5, fog = 0.60 }
local BLIND_DEAF    = { base = 1.61, reveal = 2.50, dark = 0.99, blur = 2.3, desat = 1.00, grad = 1.0, fog = 0.80 }

local function blindProfile(player)
    if MarTraitsBlind.hasTrait(player, "KeenHearing") then return BLIND_KEEN end
    if MarTraitsBlind.hasTrait(player, "HardOfHearing") then return BLIND_HARD end
    if MarTraitsBlind.hasTrait(player, "Deaf") then return BLIND_DEAF end
    return BLIND_DEFAULT
end

---------------------------------------------------------------------------
-- Project Viewpoint
--
-- Viewpoint draws its own first/third-person world and skips the vanilla pass
-- that draws the search-mode blur/darken and ImprovedFog, so on their own the
-- blind would see perfectly in 3D. The colour drain still carries over
-- (Viewpoint reads the climate desaturation set below); what goes missing is
-- the circle of sight. While Viewpoint's 3D view is on, that circle is redrawn
-- in the UI layer, which Viewpoint still renders: flat darkness with a soft
-- clear hole in the middle, sized from the same radius the iso overlay uses,
-- so echolocation opens it exactly the same way. Lua has no blur, so a light
-- haze stands in for it. Nothing is built unless Viewpoint is loaded.
---------------------------------------------------------------------------

local VIGNETTE_TEXTURE = "media/ui/MarTraitsBlind/echo_vignette.png"
-- Clear share of the texture's radius - must match CORE in tools/gen_echo_vignette.py.
local VIGNETTE_CORE = 0.6
-- A sight radius of this many tiles opens a hole reaching half the screen height.
local VIEWPOINT_REFERENCE_TILES = 10

local function viewpointActive()
    local vp = Viewpoint
    if not (vp and vp.View and vp.View.next) then return false end
    -- next() offers "first" exactly when its 3D view is off.
    return vp.View.next() ~= "first"
end

local SightUI = ISUIElement:derive("MarTraitsBlindViewpointSight")

function SightUI:new(pnum)
    local o = ISUIElement.new(self, getPlayerScreenLeft(pnum), getPlayerScreenTop(pnum),
        getPlayerScreenWidth(pnum), getPlayerScreenHeight(pnum))
    o.pnum = pnum
    o.texture = getTexture(VIGNETTE_TEXTURE)
    o.radiusTiles = 0
    o.dark = 0
    o.haze = 0
    return o
end

function SightUI:render()
    if not viewpointActive() then return end

    -- Follow resolution and split-screen layout changes.
    local pnum = self.pnum
    self:setX(getPlayerScreenLeft(pnum))
    self:setY(getPlayerScreenTop(pnum))
    self:setWidth(getPlayerScreenWidth(pnum))
    self:setHeight(getPlayerScreenHeight(pnum))
    local w, h = self.width, self.height

    if self.haze > 0 then
        self:drawRect(0, 0, w, h, self.haze, 0.62, 0.62, 0.62)
    end

    local a = self.dark
    if a <= 0 then return end

    -- The texture's clear core is the hole; flat black covers everything past
    -- the texture's square.
    local hole = self.radiusTiles / VIEWPOINT_REFERENCE_TILES * h * 0.5
    local half = hole / VIGNETTE_CORE
    local cx, cy = w * 0.5, h * 0.5
    local x0, y0, x1, y1 = cx - half, cy - half, cx + half, cy + half

    if self.texture then
        self:drawTextureScaled(self.texture, x0, y0, half * 2, half * 2, a, 1, 1, 1)
    end
    if y0 > 0 then self:drawRect(0, 0, w, y0, a, 0, 0, 0) end
    if y1 < h then self:drawRect(0, y1, w, h - y1, a, 0, 0, 0) end
    local top, bottom = math.max(y0, 0), math.min(y1, h)
    if bottom > top then
        if x0 > 0 then self:drawRect(0, top, x0, bottom - top, a, 0, 0, 0) end
        if x1 < w then self:drawRect(x1, top, w - x1, bottom - top, a, 0, 0, 0) end
    end
end

local sightUIs = {}

local function setViewpointSight(pnum, radiusTiles, dark, haze)
    -- Viewpoint only renders its 3D view for the first local player.
    if Viewpoint == nil or pnum ~= 0 then return end
    local ui = sightUIs[pnum]
    if not ui then
        ui = SightUI:new(pnum)
        ui:initialise()
        ui:instantiate()
        ui.javaObject:setConsumeMouseEvents(false)
        ui.javaObject:setIgnoreLossControl(true)
        ui:addToUIManager()
        ui:backMost() -- under the HUD, over the world
        sightUIs[pnum] = ui
    end
    ui.radiusTiles = radiusTiles
    ui.dark = dark
    ui.haze = haze
end

local function clearViewpointSight(pnum)
    local ui = sightUIs[pnum]
    if ui then
        ui:removeFromUIManager()
        sightUIs[pnum] = nil
    end
end

-- CATARACTS: a permanent hazy, washed-out, blurred view that dims with distance.
-- No pure-black darkness, but it CAN echolocate (Shout) for a temporary boost.
-- radius is +50% of the old value so it sees a bit further; reveal is the echo
-- boost.
local CATARACTS = { radius = 5.25, reveal = 3.0, dark = 0.35, blur = 1.1, desat = 0.78, grad = 4.0, fog = 0.40 }

local function applyVisionOverlay(player, playerNum, mode)
    -- Zoom multiplier: zooming the camera out shrinks the whole view (if enabled).
    local zoomMul = 1
    if SandboxVars.MarTraitsBlind.ZoomAffectsVisibility then
        local zoom = getCore():getZoom(playerNum) or 1
        zoomMul = clamp(1 - (zoom - 1) * 0.2, 0.4, 1)
    end

    -- "Blind Visibility" (ShaderStrength, default 15) -> a view-SIZE multiplier
    -- (default 1.0): it scales how big the whole sight circle is, resting and
    -- echo alike. FogStrength scales the haze.
    local vis = clamp((SandboxVars.MarTraitsBlind.ShaderStrength or 15) / 15, 0.3, 3.0)
    local fogStrength = clamp(SandboxVars.MarTraitsBlind.FogStrength or 1, 0, 3)

    -- Echo "amount", fading out smoothly over the pulse. This is the RAW sandbox
    -- strength (yell ~2.4, sneak ~1.2 by default) scaled by remaining time, so
    -- the strength sliders keep scaling the circle instead of saturating.
    local amount = 0
    if echoTime > 0 then
        amount = echoStrength * (echoTime / math.max(echoTimeMax, 0.001))
        echoTime = echoTime - getGameTime():getTimeDelta()
    else
        echoTime = 0
        echoStrength = 0
        player:getModData().isBlindEchoLocating = false
    end
    -- 0.5 maps a default yell (strength 2.4) to ~1.2. "reach" sizes the echo part
    -- of the circle; "clear" drives bounded effects (blur/fog) and stays 0..1.
    local reach = clamp(amount * 0.5, 0, 3)
    local clear = clamp(amount * 0.5, 0, 1)
    -- Visibility + zoom scale the whole circle (resting base + echo reveal).
    local sizeMul = vis * zoomMul

    local radiusV, blurV, desatV, darkV, fogV
    local gradientV = 3.0      -- falloff width of the clear circle
    local worldDesat = 0       -- climate desaturation (greys the otherwise-clear core)
    local indoorRelief = false -- whether rooms get a clearer interior value

    if mode == "blind" then
        local p = blindProfile(player)
        -- A pulse widens the clear circle (strength scales how far, up to 3x the
        -- profile reveal); the whole thing is then scaled by visibility + zoom.
        -- The dark beyond stays near-black so the cutoff holds in daylight.
        radiusV   = clamp((p.base + reach * p.reveal) * sizeMul, 0, (p.base + p.reveal * 3) * vis)
        darkV     = p.dark -- NOT lifted by echo => hard cutoff past the circle
        blurV     = clamp(p.blur * (1 - clear * 0.4), 0, 3)
        desatV    = p.desat
        fogV      = clamp(p.fog * fogStrength * (1 - clear * 0.4), 0, 1)
        gradientV = p.grad
        worldDesat = 0.97 -- near-full greyscale, core included
    else -- cataracts: a static hazy view, always at least partly visible
        local c = CATARACTS
        radiusV   = clamp((c.radius + reach * c.reveal) * sizeMul, 0, (c.radius + c.reveal * 3) * vis)
        darkV     = clamp(c.dark  * (1 - clear * 0.4), 0.05, 1)
        blurV     = clamp(c.blur  * (1 - clear * 0.4), 0, 3)
        desatV    = clamp(c.desat * (1 - clear * 0.3), 0, 1)
        fogV      = clamp(c.fog   * fogStrength * (1 - clear * 0.5), 0, 1)
        gradientV = c.grad
        worldDesat = 0.45 -- washed-out, but keep some colour
        indoorRelief = true
    end

    if SandboxVars.MarTraitsBlind.MoonsideMode then
        desatV = clamp(desatV * 0.4, 0, 1) -- Moonside: keep more colour
        worldDesat = worldDesat * 0.25
    end

    -- The clear core is desaturated only by the world (climate) desaturation, so
    -- this is the one lever that drains colour from it. Re-applied each tick.
    getClimateManager():setDesaturation(worldDesat)
    -- In vanilla B42, RenderSettings:updateRenderSettings() multiplies desaturation
    -- by (1.0 - darkness), where darkness = (1.0 - dayLightStrength). At night,
    -- dayLightStrength drops to 0, which zeroes out desaturation and reveals full
    -- colour inside the sight circle. Pinning dayLightStrength to 1.0 preserves
    -- the desaturation filter at night.
    getClimateManager():setDayLightStrength(1.0)

    -- Interior (indoor) values. Blind stays black indoors too; cataracts eases up
    -- a little so rooms are readable.
    local iBlur, iDesat, iDark = blurV, desatV, darkV
    if indoorRelief then
        iBlur  = blurV * 0.6
        iDesat = desatV * 0.8
        iDark  = darkV * 0.7
    end

    local searchMode = getSearchMode()
    local psm = searchMode:getSearchModeForPlayer(playerNum)
    searchMode:setEnabled(playerNum, true)
    searchMode:setOverride(playerNum, true) -- use the explicit exterior/interior values below

    local radius = psm:getRadius();         radius:setExterior(radiusV);   radius:setInterior(radiusV)
    local gradient = psm:getGradientWidth(); gradient:setExterior(gradientV); gradient:setInterior(gradientV)
    local blur = psm:getBlur();             blur:setExterior(blurV);       blur:setInterior(iBlur)
    local desat = psm:getDesat();           desat:setExterior(desatV);     desat:setInterior(iDesat)
    local dark = psm:getDarkness();         dark:setExterior(darkV);       dark:setInterior(iDark)

    ImprovedFog.setBaseAlpha(fogV)

    -- The same circle for Viewpoint's 3D view; the haze stands in for the blur.
    setViewpointSight(playerNum, radiusV, darkV, clamp(fogV * 0.5, 0, 0.5))
end

local function disableBlindOverlay(player, playerNum)
    local searchMode = getSearchMode()
    player:setWearingNightVisionGoggles(false)
    searchMode:setEnabled(playerNum, false)
    searchMode:setOverride(playerNum, false)
    ImprovedFog.setBaseAlpha(0)
    local cm = getClimateManager()
    if cm then
        cm:setDesaturation(0) -- hand colour back to the climate system
        local cv = cm:getClimateValuesCopy()
        if cv and cv.getDayLightStrength then
            cm:setDayLightStrength(cv:getDayLightStrength())
        end
    end
    clearViewpointSight(playerNum)
end

---------------------------------------------------------------------------
-- Per-player tick
---------------------------------------------------------------------------

local function traitBlindCheck(player)
    if player == nil then return end
    local playerNum = player:getPlayerNum()
    local md = player:getModData()

    local mode = nil
    if MarTraitsBlind.isBlind(player) then
        mode = "blind"
    elseif MarTraitsBlind.isCataracts(player) then
        mode = "cataracts"
    end

    if mode then
        md.blindOverlayActive = true
